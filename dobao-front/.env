# 业务接口前缀：留空表示直接用后端既有路径（/session、/file、/interview、/agent、/auth），
# 由 vite.config.ts 的 server.proxy 转发到后端 8888，浏览器视角同源。
VITE_API_BASE=

# 登录跳转与后端回跳所用的后端根地址。
# ⚠️ 主机名必须与后端 github.oauth.redirect-uri 一致（都用 localhost，不要写 127.0.0.1），
#    否则会话 Cookie 会绑在另一个站点上，表现为"授权成功却仍未登录"。
VITE_AUTH_BASE=http://localhost:8888

# 旧变量：绝对后端地址，已废弃（改用同源代理）
# VITE_BACKEND_URL=http://localhost:8888
