flowchart TD

subgraph Q1["⑤ 本轮结束判定"]
  C0["⬅️ 承接流程图一<br/>本轮推理已结束"]
  R7{"本轮是否为<br/>TOOL_CALL"}
end

subgraph Q2["⑥ 出最终答案"]
  F0["本轮 textBuffer<br/>即最终答案"]
  F1["推送 type=text<br/>最终答案正文"]
  F2{"是否已积累<br/>搜索结果"}
  F3["推送 type=reference<br/>参考来源与数量"]
  F4{"是否开启<br/>推荐问题"}
  F5["再次调用模型<br/>生成 3 个推荐问题"]
  F6["推送 type=recommend"]
  F7["tryEmitComplete<br/>结束本次流"]
end

subgraph Q3["⑦ 调用搜索工具"]
  R8{"轮次是否达到<br/>上限 5 轮"}
  R9["forceFinalStream 强制收尾<br/>重排系统提示词<br/>注入禁止调用工具指令"]
  R10["推送 type=thinking<br/>🔍 正在搜索信息"]
  R11["callback.call 执行<br/>Tavily 搜索工具<br/>超时 120 秒"]
  R12{"工具是否执行成功"}
  R13["addErrorToolResponse<br/>失败信息写回 messages"]
  R14["ToolResponseMessage<br/>写回 messages<br/>并记录工具名"]
  R15{"工具名是否<br/>含 tavily"}
  R16["parseSearchResult<br/>提取结果存入<br/>searchResults"]
  R17["工具完成计数加一"]
  R18{"本轮工具<br/>是否都已返回"}
  R19["开启下一轮推理"]
end

subgraph Q4["⑧ 落库收尾"]
  E1["doFinally 收尾<br/>打印最终答案与思考"]
  E2{"答案非空且<br/>会话 id 存在"}
  E3["saveSessionResult<br/>组装答案, 思考<br/>工具, 引用, 推荐<br/>首响与总耗时"]
  M11[("🗄️ updateAnswer 回写<br/>ai_session UPDATE")]
  E4["stopTask 移除任务<br/>释放订阅"]
  Z1["前端解析 SSE<br/>渲染思考, 正文<br/>参考来源, 推荐问题"]
end

C0 --> R7
R7 -- 否, 未调用工具即最终答案 --> F0 --> F1 --> F2
F2 -- 是 --> F3 --> F4
F2 -- 否 --> F4
F4 -- 是 --> F5 --> F6 --> F7
F4 -- 否 --> F7
F7 --> E1

R7 -- 是, 要求调用工具 --> R8
R8 -- 是, 已达上限 --> R9 --> F0
R8 -- 否 --> R10 --> R11 --> R12
R12 -- 否 --> R13 --> R17
R12 -- 是 --> R14 --> R15
R15 -- 是 --> R16 --> R17
R15 -- 否 --> R17
R17 --> R18
R18 -- 否, 等待其他工具 --> R17
R18 -- 是 --> R19
R19 -. 循环回到图一推理 .-> C0

E1 --> E2
E2 -- 是 --> E3 --> M11 --> E4
E2 -- 否 --> E4
E4 --> Z1

